# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# --- LLM (discovery loop only; replay never reads these) ---
ANTHROPIC_API_KEY=sk-ant-...
CUA_MODEL=claude-sonnet-5

# --- Target surface ---
# Public Parasoft test site. No real PII; register throwaway customers.
CUA_PARABANK_BASE_URL=https://parabank.parasoft.com/parabank
CUA_SAUCEDEMO_BASE_URL=https://www.saucedemo.com

# --- Session Host control plane (local only) ---
CUA_SESSION_HOST=127.0.0.1:8787

# --- Run behaviour ---
CUA_HEADED=1
CUA_MAX_STEPS=40
CUA_STEP_TIMEOUT_S=20
CUA_RUN_TIMEOUT_S=300
